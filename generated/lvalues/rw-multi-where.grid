atom     lvalues/rw-multi-where
source   generated
gen      gen/lvalues.raku
law      a write through `rm({T}, ())`  ===  a write straight to `{T}`
ladder   8 targets x 3 writes

- id     0001
  from   law:write-through
  cell   scalar | rw-multi-where | assign
  code   do { my $v = 1; multi rm($x is rw, @s where { .elems == 0 }) is rw { return-rw $x }; rm($v, ()) = 7; $v }
  same-as do { my $v = 1; $v = 7; $v }

