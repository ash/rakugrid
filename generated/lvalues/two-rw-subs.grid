atom     lvalues/two-rw-subs
source   generated
gen      gen/lvalues.raku
law      a write through `rb({T})`  ===  a write straight to `{T}`
ladder   8 targets x 3 writes

- id     0001
  from   law:write-through
  cell   scalar | two-rw-subs | assign
  code   do { my $v = 1; sub ra($x is rw) is rw { return-rw $x }; sub rb($x is rw) is rw { return-rw ra($x) }; rb($v) = 7; $v }
  same-as do { my $v = 1; $v = 7; $v }

