  from   inventory:Range.^methods
  cell   path | (1..3)
  code   ((1..3)).path
  is     IO::Path.new("1 2 3", :SPEC(IO::Spec::Unix), :CWD("/Users/ash/rakugrid"))
  type   IO::Path
  oracle rakudo-2026.07 → IO::Path.new("1 2 3", :SPEC(IO::Spec::Unix), :CWD("/Users/ash/rakugrid"))
  oracle rakupp-3.14.0 → "1 2 3"
  verdict disputed
