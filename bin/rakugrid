#!/usr/bin/env raku
# rakugrid — the Rakugrid harness.
#
#   rakugrid fire [<selector>]     run tests, emit TAP
#   rakugrid check                 the build rule: no unsigned divergences
#   rakugrid cover                 which atoms have tests, which do not
#   rakugrid isolate <id>          print one test as a standalone program
#   rakugrid adjudications         the ledger of signed rulings
#
# Options: --engine=<cmd> (default $RAKUGRID_ENGINE or `raku`), --keep, --verbose
#
# Deliberately one file: rakupp's `is export` on many-sub modules is still
# unreliable, and the harness must run unchanged on every implementation it
# tests. See docs/FORMAT.md for the .grid format this parses.

my $ROOT   = $*PROGRAM.IO.absolute.IO.parent.parent;
# The engine under test defaults to THE ONE RUNNING THE HARNESS. Rakugrid is
# engine-neutral by design, so there is no correct implementation to hard-code;
# `rakupp bin/rakugrid fire` tests rakupp, `raku bin/rakugrid fire` tests Rakudo,
# and --engine= overrides either. `.Str` rather than `.absolute`, which returns
# an IO::Path on one engine and a Str on the other.
my $ENGINE = %*ENV<RAKUGRID_ENGINE> // $*EXECUTABLE.Str;
my $KEEP   = False;
my $GUARD  = 0;
my $VERB   = False;
my $CLASSIFY = False;

# ---------------------------------------------------------------- the format

# A .grid file is a header of `name value` lines at column 0, then records.
# A record opens with `- id <n>`; its fields are indented two spaces. A field
# whose own line is empty takes the indented block that follows. Repeated
# fields (oracle, from) accumulate.

sub parse-grid($path) {
    my %header;
    my @records;
    my %cur;
    my @lines = $path.IO.lines;
    my $n = @lines.elems;
    my $i = 0;

    sub flush() {
        if %cur {
            @records.push: %cur.clone;
            %cur = ();
        }
    }

    while $i < $n {
        my $line = @lines[$i];
        $i++;

        next if $line ~~ /^ \s* '#'/;
        if $line ~~ /^ \s* $/ {
            flush();
            next;
        }

        # record opener: `- id  0041`
        if $line ~~ /^ '-' \s+ (\w+) \s+ (.*) $/ {
            flush();
            %cur{~$0} = ~$1;
            %cur<_file> = ~$path;
            next;
        }

        # indented field
        if $line ~~ /^ '  ' (\w[\w|'-']*) (.*) $/ {
            my $name  = ~$0;
            my $value = (~$1).trim;

            if $value eq '' {
                # block value: everything indented deeper, until it dedents
                my @block;
                while $i < $n && (@lines[$i] ~~ /^ '    ' / || @lines[$i] ~~ /^ \s* $/) {
                    last if @lines[$i] ~~ /^ \s* $/
                            && !((@lines[$i+1] // '') ~~ /^ '    ' /);
                    @block.push: (@lines[$i] ~~ /^ '    ' (.*) $/) ?? ~$0 !! '';
                    $i++;
                }
                $value = @block.join("\n");
            }
            if $name eq 'oracle' | 'from' {
                %cur{$name} = [] unless %cur{$name}:exists;
                %cur{$name}.push: $value;
            }
            else {
                %cur{$name} = $value;
            }
            next;
        }

        # header line at column 0
        if $line ~~ /^ (\w[\w|'-']*) \s+ (.*) $/ {
            %header{~$0} = (~$1).trim;
        }
    }
    flush();

    return { header => %header, records => @records };
}

# Expected values are compared as `.raku` TEXT, never by re-compiling them: a
# value's own `.raku` is not always re-parseable (`18446744073709551616.0` is
# not), and text comparison also makes NaN compare equal to NaN, which is what a
# test wants and what `==` will not give.
sub raku-literal($s) {
    return "'" ~ $s.subst('\\', '\\\\', :g).subst("'", "\\'", :g) ~ "'";
}

# The one assertion each record makes. Exactly one of these must be present.
constant @ASSERTIONS = <is type throws output finishes same-as parses no-parse>;

# `type` is a modifier when it accompanies another assertion — "this expression
# produces this value, of this type" is one behaviour — and an assertion in its
# own right when it stands alone.
sub assertion-of(%r) {
    my @found = @ASSERTIONS.grep({ %r{$_}:exists });
    return @found.grep({ $_ ne 'type' }) if @found > 1 && @found.grep({ $_ eq 'type' });
    return @found;
}

# The authoritative oracle: newest line for the reference implementation.
sub authoritative(%r, $reference = 'rakudo') {
    my @lines = (%r<oracle> // []).grep({ $_.starts-with($reference) });
    return @lines ?? @lines[*-1] !! Nil;
}

# An oracle line is one line by construction, so a multi-line observation is
# recorded as a summary: `<first line> …(N lines)`. Comparing a summary against
# a full expected value has to compare what the summary actually carries, or
# every multi-line record reads as an unsigned divergence.
sub observation-matches($observed, $asserted) {
    if $observed ~~ / (.*?) \s* '…(' (\d+) ' lines)' $/ {
        my $head  = ~$0;
        my $count = +$1;
        my @lines = $asserted.lines;
        return @lines.elems == $count && (@lines[0] // '') eq $head;
    }
    return $observed eq $asserted;
}

# A rejection's WORDING is not specified, so two engines refusing the same
# fragment agree even when they say so differently. Compare the structural fact.
sub comparable($o) {
    return 'rejected' if $o.starts-with('rejected:');
    return $o;
}

sub oracle-observation($line) {
    return ~$0 if $line ~~ / '→' \s* (.*) $/;
    return '';
}

sub grid-files() {
    my @out;
    for <atoms generated molecules> -> $dir {
        my $d = $ROOT.add($dir);
        next unless $d.e;
        @out.append: find-grid($d);
    }
    return @out.sort;
}

sub find-grid($dir) {
    my @out;
    for $dir.dir -> $e {
        if $e.d {
            @out.append: find-grid($e);
        }
        elsif $e.extension eq 'grid' {
            @out.push: $e;
        }
    }
    return @out;
}

sub atom-of(%parsed) {
    return %parsed<header><atom> // 'unknown';
}

sub id-of(%parsed, %r) {
    return 'grid:' ~ atom-of(%parsed) ~ '#' ~ (%r<id> // '????');
}

# ------------------------------------------------------------------- program

# Build one dense program per file. Assertions that need process isolation
# (parses / no-parse / finishes / output) are not emitted here — they belong to
# the isolated lane, which `fire` reports as skipped until it is built.

constant @IN-PROCESS = <is type throws same-as>;

constant @ISOLATED = <parses no-parse finishes output>;

# A guarded run: the child is backgrounded under /bin/sh with a watchdog that
# kills it after $secs. Deliberately shell rather than Proc::Async — this has to
# behave identically on every engine the harness runs under, and a busy loop
# must not be able to starve the watchdog.
sub sh-quote($s) {
    return "'" ~ $s.subst("'", "'\\''", :g) ~ "'";
}

sub run-guarded($cmd, @args, $secs = 10, $cwd = '') {
    my $line = ([$cmd, |@args].map({ sh-quote($_) })).join(' ');
    $line = "cd { sh-quote($cwd) } && $line" if $cwd;

    # Output goes to FILES, never to a pipe. A killed program can leave a
    # grandchild alive holding an inherited pipe, and then the read waits for an
    # EOF that never comes — the watchdog fires, the process dies, and the
    # harness hangs anyway. Files have no such dependency on who else is
    # holding the descriptor. The watchdog also kills the whole process group
    # where the shell supports job control, so those grandchildren go too.
    my $base = tmpdir().add('guard-' ~ $*PID ~ '-' ~ $GUARD++);
    my $o = $base.absolute ~ '.out';
    my $e = $base.absolute ~ '.err';

    my $script = "exec >/dev/null 2>&1; set -m 2>/dev/null || true; "
               ~ "$line > { sh-quote($o) } 2> { sh-quote($e) } & p=\$!; "
               ~ "( sleep $secs; kill -9 -\$p 2>/dev/null || kill -9 \$p 2>/dev/null ) & w=\$!; "
               ~ "wait \$p; rc=\$?; kill \$w 2>/dev/null; exit \$rc";

    my $p = run('/bin/sh', '-c', $script);
    my $out = $o.IO.e ?? $o.IO.slurp !! '';
    my $err = $e.IO.e ?? $e.IO.slurp !! '';
    $o.IO.unlink if $o.IO.e;
    $e.IO.unlink if $e.IO.e;
    return { out => $out, err => $err, exit => $p.exitcode, timeout => $p.exitcode == 137 };
}

sub budget-of(%r) {
    my $b = %r<budget> // %r<finishes> // '10s';
    return +$0 if $b ~~ /(\d+)/;
    return 10;
}

# A record parked by an unresolved ruling does not run. It is not a pass and not
# a failure — it is a question nobody has answered yet, and it is counted as one.
sub parked(%r) {
    return (%r<verdict> // '') eq 'disputed';
}

sub emit-program(%parsed, @records) {
    my @body;
    my @ran;

    for @records -> %r {
        my @a = assertion-of(%r);
        next unless @a == 1;
        next unless @a[0] eq any(@IN-PROCESS);
        @ran.push: %r;
        @body.push: emit-record(%parsed, %r, @a[0]);
    }

    my $prelude = q:to/END/;
    my $i = 0;
    sub tap($ok, $desc, $diag = '') {
        $i++;
        if $ok {
            say "ok $i - $desc";
        }
        else {
            say "not ok $i - $desc";
            say "# " ~ $diag if $diag;
        }
    }
    END

    my $src = "# generated by rakugrid — do not edit\n"
            ~ "say \"1..{ @ran.elems }\";\n"
            ~ $prelude
            ~ @body.join("\n");

    return { source => $src, ran => @ran };
}

sub indent($text, $by = 8) {
    return $text.lines.map({ (' ' x $by) ~ $_ }).join("\n");
}

sub emit-record(%parsed, %r, $kind) {
    my $id    = id-of(%parsed, %r);
    my $setup = %r<setup> // '';
    my $code  = %r<code>  // '';
    my $desc  = $id;

    my $subject = ($setup ?? $setup ~ "\n" !! '') ~ $code;

    if $kind eq 'is' {
        my $exp   = %r<is>;
        my $wtype = %r<type> // '';
        # The type name goes in through raku-literal, never raw. A mixin renders
        # as `Nil+{Mu::Suggestion[Block]}`, and interpolating that into a
        # double-quoted diagnostic makes the generated program evaluate
        # `{Mu::Suggestion[Block]}` as a block — which does not compile, so the
        # test could never run at all.
        my $tcheck = $wtype
            ?? " && \$got.WHAT.^name eq { raku-literal($wtype) }"
            !! '';
        my $tdiag = $wtype
            ?? " ~ ' (type ' ~ \$got.WHAT.^name ~ ', expected ' ~ { raku-literal($wtype) } ~ ')'"
            !! '';
        return qq:to/END/;
        \{
            my \$got = try \{
        { indent($subject, 8) }
            \};
            my \$err = \$! ?? \$!.^name !! '';
            my \$exp = { raku-literal($exp) };
            tap(!\$err && \$got.raku eq \$exp{ $tcheck }, "$desc",
                \$err ?? "threw \$err" !! "got " ~ \$got.raku ~ ", expected " ~ \$exp{ $tdiag });
        \}
        END
    }

    if $kind eq 'type' {
        my $exp = %r<type>;
        return qq:to/END/;
        \{
            my \$got = try \{
        { indent($subject, 8) }
            \};
            my \$err = \$! ?? \$!.^name !! '';
            tap(!\$err && \$got.WHAT.^name eq '{ $exp }', "$desc",
                \$err ?? "threw \$err" !! "got type " ~ \$got.WHAT.^name ~ ", expected { $exp }");
        \}
        END
    }

    if $kind eq 'same-as' {
        my $other = %r<same-as>;
        return qq:to/END/;
        \{
            my \$got = try \{
        { indent($subject, 8) }
            \};
            my \$e1 = \$! ?? \$!.^name !! '';
            my \$alt = try \{ { $other } \};
            my \$e2 = \$! ?? \$!.^name !! '';
            tap(\$e1 eq \$e2 && \$got.raku eq \$alt.raku, "$desc",
                "got " ~ \$got.raku ~ " vs " ~ \$alt.raku);
        \}
        END
    }

    if $kind eq 'throws' {
        my $exp = %r<throws>;
        return qq:to/END/;
        \{
            my \$ok = False;
            my \$saw = 'nothing';
            try \{
        { indent($subject, 8) }
            \};
            if \$! \{
                \$saw = \$!.^name;
                \$ok  = \$!.^name eq '{ $exp }' || \$! ~~ ::('{ $exp }');
            \}
            tap(\$ok, "$desc", "threw " ~ \$saw ~ ", expected { $exp }");
        \}
        END
    }

    return '';
}

# ---------------------------------------------------------------- subcommands

my $SEQ = 0;
my $BAD = 0;
my $PARKED = 0;
my $RULED = 0;

# Which implementation are we testing? Needed to tell an ordinary failure from
# one we have already ruled on: a record that says the reference is wrong is
# SUPPOSED to fail against the reference.
my $ENGINE-ID = '';
sub engine-id() {
    return $ENGINE-ID if $ENGINE-ID;
    my $p = run($ENGINE, '-e', 'print $*RAKU.compiler.name', :out, :err);
    my $name = $p.out.slurp(:close).trim;
    $p.err.slurp(:close);
    if $name.contains('Raku++') || $name.lc.contains('rakupp') {
        my $v = run($ENGINE, '--version', :out, :err);
        my $text = $v.out.slurp(:close);
        $v.err.slurp(:close);
        my $ver = $text ~~ /(\d+ '.' \d+ '.' \d+)/ ?? ~$0 !! 'unknown';
        return $ENGINE-ID = "rakupp-$ver";
    }
    my $p2 = run($ENGINE, '-e', 'print $*RAKU.compiler.version', :out, :err);
    my $ver = $p2.out.slurp(:close).trim;
    $p2.err.slurp(:close);
    return $ENGINE-ID = ($name || 'unknown') ~ '-' ~ ($ver || 'unknown');
}

# A signed ruling that names THIS implementation means we expect it to differ.
# Reported as a TAP TODO: visible, counted, and not a build failure.
sub expected-to-fail(%r) {
    my $v = %r<verdict> // '';
    return False unless $v;
    return False if $v eq 'disputed';
    my $ruled = %r<ruled> // '';
    return False unless $ruled ~~ / 'against' \s+ (\S+) /;
    return ~$0 eq engine-id();
}

sub report($ok, $desc, $diag = '', $todo = '') {
    $SEQ++;
    if $ok {
        say "ok $SEQ - $desc";
    }
    elsif $todo {
        say "not ok $SEQ - $desc # TODO ruled: $todo";
        $RULED++;
        say "# $_" for $diag.lines.grep({ .trim }).head(2);
    }
    else {
        say "not ok $SEQ - $desc";
        $BAD++;
        say "# $_" for $diag.lines.grep({ .trim }).head(4);
    }
}

sub tmpdir() {
    my $t = $ROOT.add('tmp');
    $t.mkdir unless $t.e;
    return $t;
}

# Isolated programs run from tmp/run/, which mirrors the layout an imported
# whole-program record was written against: a sibling `fixtures/` one level up,
# reachable as $?FILE.IO.parent.parent.add('fixtures').
sub rundir() {
    my $t = tmpdir();
    my $r = $t.add('run');
    $r.mkdir unless $r.e;
    my $link = $t.add('fixtures');
    if !$link.e && $ROOT.add('fixtures').d {
        run('ln', '-s', $ROOT.add('fixtures').absolute, $link.absolute, :out, :err);
    }
    return $r;
}

# One record, run in its own process. Used both for the isolated assertions and
# as the fallback when a dense file loses tests — a crash then costs one result
# instead of the whole file.
sub fire-one(%parsed, %r) {
    my $id   = id-of(%parsed, %r);
    my @a    = assertion-of(%r);
    my $kind = @a[0] // '';
    my $secs = budget-of(%r);
    my $tmp  = rundir();

    my $subject = (%r<setup> ?? %r<setup> ~ "\n" !! '') ~ (%r<code> // '');

    my $todo = expected-to-fail(%r) ?? (%r<verdict> // '') !! '';

    if $kind eq 'parses' | 'no-parse' {
        # Named after the atom, not `one.raku`: a whole-program record can read
    # $?FILE or $*PROGRAM, and a generic temp name changes what it sees.
    my $src = $tmp.add(atom-of(%parsed).split('/')[*-1] ~ '.raku');
        # The trailing newline is not cosmetic: a heredoc scans the lines that
        # follow it, so `q:to{abc}` parses differently in a file that ends
        # without one. Write it exactly as the oracle was captured.
        $src.spurt($subject.ends-with("\n") ?? $subject !! $subject ~ "\n");
        my %g = run-guarded($ENGINE, ['-c', $src.absolute], $secs, $tmp.absolute);
        $src.unlink unless $KEEP;
        my $compiled = %g<exit> == 0;

        if $kind eq 'parses' {
            report($compiled, $id, %g<err>, $todo);
        }
        else {
            my $want = %r<error> // '';
            my $said = %g<out> ~ %g<err>;
            report(!$compiled && (!$want || $said.contains($want)), $id,
                   $compiled ?? "compiled, expected a parse failure"
                             !! "reported: { $said.lines.head(2).join(' ') }", $todo);
        }
        return;
    }

    # everything else needs the program actually run
    # Named after the atom, not `one.raku`: a whole-program record can read
    # $?FILE or $*PROGRAM, and a generic temp name changes what it sees.
    my $src = $tmp.add(atom-of(%parsed).split('/')[*-1] ~ '.raku');
    # `[%r]` would flatten the record into Pairs — push keeps it one element.
    my @one;
    @one.push: %r;
    my $wrapped = $kind eq any(@IN-PROCESS)
        ?? emit-program(%parsed, @one)<source>
        !! $subject;
    $src.spurt($wrapped.ends-with("\n") ?? $wrapped !! $wrapped ~ "\n");
    # A whole-program record may create and then `use` a sibling file. Run it
    # with the temp directory as the working directory so relative paths, and
    # $?FILE.IO.parent, agree with where the program actually sits.
    my %g = run-guarded($ENGINE, [$src.absolute], $secs, $tmp.absolute);
    $src.unlink unless $KEEP;

    if $kind eq 'finishes' {
        report(!%g<timeout> && %g<exit> == 0, $id,
               %g<timeout> ?? "did not finish within {$secs}s"
                           !! "exit { %g<exit> }: { %g<err>.lines.head(2).join(' ') }", $todo);
        return;
    }

    if $kind eq 'output' {
        my $want = %r<output> // '';
        my $got  = %g<out>.chomp;
        report(!%g<timeout> && $got eq $want.chomp, $id,
               %g<timeout> ?? "did not finish within {$secs}s"
                           !! "got: { $got.lines.head(2).join(' ') }", $todo);
        return;
    }

    # an in-process assertion, re-run alone because the dense file lost it
    my $line = %g<out>.lines.first({ .starts-with('ok ') || .starts-with('not ok ') });
    if !$line {
        my $why = %g<timeout>
            ?? "did not finish within {$secs}s"
            !! "no result (exit { %g<exit> }): { (%g<err> ~ %g<out>).lines.grep({ .trim }).head(2).join(' ') }";
        report(False, $id, $why, $todo);
        return;
    }
    report($line.starts-with('ok '), $id,
           %g<out>.lines.grep({ .starts-with('# ') }).head(2).join("\n").subst('# ', ''), $todo);
}

sub cmd-fire(@selector) {
    my @files = grid-files();
    @files = @files.grep({ so @selector.first({ ~$^s && $_.absolute.contains($^s) }) }) if @selector;

    unless @files {
        note "no .grid files found under atoms/, generated/ or molecules/";
        exit 0;
    }

    my $recovered = 0;

    for @files -> $f {
        my %parsed = parse-grid($f);
        my @dense;
        my @lone;

        for %parsed<records>.list -> %r {
            my @a = assertion-of(%r);
            next unless @a == 1;
            if parked(%r) {
                $PARKED++;
                next;
            }
            if @a[0] eq any(@IN-PROCESS) {
                @dense.push: %r;
            }
            elsif @a[0] eq any(@ISOLATED) {
                @lone.push: %r;
            }
        }

        if @dense {
            my %p  = emit-program(%parsed, @dense);
            my $out = tmpdir().add($f.basename ~ '.gen.raku');
            $out.spurt(%p<source>);

            my %g = run-guarded($ENGINE, [$out.absolute], 120);
            $out.unlink unless $KEEP;

            my %result;
            my $last = '';
            for %g<out>.lines -> $l {
                if $l ~~ /^ ('not ' )? 'ok' \s+ \d+ \s* '-' \s* (\S+) / {
                    $last = ~$1;
                    %result{$last} = { ok => !$0, diag => '' };
                }
                elsif $l.starts-with('# ') && $last {
                    %result{$last}<diag> ~= $l.substr(2) ~ "\n";
                }
            }

            my @lost;
            for @dense -> %r {
                my $id = id-of(%parsed, %r);
                if %result{$id}:exists {
                    report(%result{$id}<ok>, $id, %result{$id}<diag>,
                           expected-to-fail(%r) ?? (%r<verdict> // '') !! '');
                }
                else {
                    @lost.push: %r;
                }
            }

            # The dense file died partway. Re-run what it lost, one process
            # each, so a crash costs one result rather than the whole file.
            if @lost {
                say "# { %parsed<header><atom> // $f.basename }: dense run lost { @lost.elems }, re-running individually";
                $recovered += @lost.elems;
                fire-one(%parsed, $_) for @lost;
            }
        }

        fire-one(%parsed, $_) for @lone;
    }

    my $note = $recovered ?? ", $recovered re-run individually after a dense-run failure" !! '';
    my $park = $PARKED ?? ", $PARKED parked on an unresolved ruling" !! '';
    my $rule = $RULED  ?? ", $RULED failed as ruled"                  !! '';
    say "# $SEQ ran, $BAD failed$note$park$rule";
    exit $BAD ?? 1 !! 0;
}

# The build rule. An assertion that differs from the authoritative oracle needs
# a signed verdict, a rationale and a date it was ruled against.
sub cmd-check() {
    my $problems = 0;

    for grid-files() -> $f {
        my %parsed = parse-grid($f);

        for %parsed<records>.list -> %r {
            my $id = id-of(%parsed, %r);
            my @a  = assertion-of(%r);

            if @a == 0 {
                say "$id: no assertion";
                $problems++;
                next;
            }
            if @a > 1 {
                say "$id: { @a.elems } assertions ({ @a.join(', ') }) — one test, one behaviour";
                $problems++;
            }
            unless %r<from> {
                say "$id: no provenance";
                $problems++;
            }

            my $auth = authoritative(%r);
            next unless $auth;

            # `parses` and `no-parse` assert a structural fact, not a value.
            # There is nothing in an observation to compare them against.
            next if @a[0] eq 'parses' | 'no-parse';

            my $observed = oracle-observation($auth);

            # `same-as` asserts a RELATION between two spellings, so its
            # observation is whether they agreed — not a value to match. It
            # needs a ruling exactly when the reference says they did not.
            if @a[0] eq 'same-as' {
                next if $observed.starts-with('AGREE');
                unless %r<verdict> && %r<why> && %r<ruled> {
                    say "$id: the reference breaks this law ({ $observed }) with no ruling";
                    $problems++;
                }
                next;
            }
            my $asserted = %r{@a[0]} // '';

            # a throwing observation is recorded as `ERR:<type>`
            $observed = $observed.substr(4) if $observed.starts-with('ERR:');

            next if observation-matches($observed, $asserted);

            unless %r<verdict> && %r<why> && %r<ruled> {
                say "$id: asserts '$asserted' but { $auth } — unsigned divergence";
                $problems++;
                next;
            }
            unless %r<ruled>.contains('against') {
                say "$id: verdict is not pinned to an observation (`ruled <date> against <impl>-<version>`)";
                $problems++;
            }
        }
    }

    if $problems {
        say "# $problems problem{ $problems == 1 ?? '' !! 's' }";
        exit 1;
    }
    say "# clean";
}

sub cmd-cover() {
    my %by-atom;
    for grid-files() -> $f {
        my %parsed = parse-grid($f);
        %by-atom{atom-of(%parsed)} += %parsed<records>.elems;
    }
    for %by-atom.keys.sort -> $a {
        say sprintf("%-40s %5d", $a, %by-atom{$a});
    }
    say "# { %by-atom.elems } atoms, { %by-atom.values.sum } tests";
    say "# ladder and inventory coverage arrive with the extractors (phase 0)";
}

# The numbers the README quotes. Printed rather than hand-maintained, so they
# can be refreshed instead of drifting.
sub cmd-stats() {
    my %atoms;
    my %engines;
    my $tests = 0;
    my $crashes = 0;
    my $ruled = 0;
    my $curated = 0;
    my $generated = 0;

    my %clusters;
    my $divergent = 0;

    for grid-files() -> $f {
        my %parsed = parse-grid($f);
        my $atom = atom-of(%parsed);
        %atoms{$atom} = 1;

        if (%parsed<header><source> // '') eq 'generated' {
            $generated += %parsed<records>.elems;
        }
        else {
            $curated += %parsed<records>.elems;
        }

        for %parsed<records>.list -> %r {
            $tests++;
            $ruled++ if %r<verdict>;

            my $auth = authoritative(%r);
            my $ref-obs = $auth ?? oracle-observation($auth) !! '';

            for (%r<oracle> // []).list -> $line {
                %engines{engine-of($line)} = 1;
                $crashes++ if oracle-observation($line).starts-with('CRASH:');
                next if !$auth || $line eq $auth;
                next if engine-of($line) eq engine-of($auth);
                my $obs = oracle-observation($line);
                next if comparable($obs) eq comparable($ref-obs);
                $divergent++;
                %clusters{"{ engine-of($line) }\t{ short-obs($ref-obs) }\t{ short-obs($obs) }"} = 1;
            }
        }
    }

    say "atoms                { %atoms.elems }";
    say "tests                { $tests }   ({ $generated } generated, { $curated } curated)";
    say "engines on record    { %engines.keys.sort.join(', ') }";
    say "divergences          { $divergent } observation{ $divergent == 1 ?? '' !! 's' } in { %clusters.elems } cluster{ %clusters.elems == 1 ?? '' !! 's' }";
    say "crashes on record    { $crashes }";
    say "signed rulings       { $ruled }";
}

sub cmd-isolate($id) {
    for grid-files() -> $f {
        my %parsed = parse-grid($f);
        for %parsed<records>.list -> %r {
            next unless id-of(%parsed, %r) eq $id || (%r<id> // '') eq $id;
            say "# $id";
            say "# from: { (%r<from> // []).join(' · ') }";
            say '';
            say %r<setup> if %r<setup>;
            say %r<code>;
            return;
        }
    }
    note "no such test: $id";
    exit 1;
}

# A recorded observation, rendered short enough to scan in a grid.
sub short-obs($o) {
    return '·' unless $o;
    return abbrev-exception($o.substr(4)) if $o.starts-with('ERR:');
    return $o.chars > 10 ?? $o.substr(0, 9) ~ '…' !! $o;
}

# X::Numeric::DivideByZero → !DBZ, with the full name given in a legend. A
# matrix is only worth rendering if a row fits on a line.
sub abbrev-exception($full) {
    my $last = $full.split('::')[*-1];
    my $caps = $last.comb.grep({ $_ ~~ /<[A..Z]>/ }).join;
    $caps = $last.substr(0, 3).uc unless $caps;
    return '!' ~ $caps;
}

sub engine-of($line) {
    return ~$0 if $line ~~ /^ (\S+) /;
    return '';
}


# `.raku` output is not fully specified, so two engines can render the same
# value differently and both be right. A third of the recorded divergences turn
# out to be exactly that. `--classify` asks the reference whether the two
# renderings DENOTE the same value — it evaluates both and compares with `eqv` —
# so a semantic difference can be told from a spelling one.
constant $EQV-PROBE = q:to/END/;
    use MONKEY-SEE-NO-EVAL;
    for @*ARGS[0].IO.lines -> $line {
        my ($a, $b) = $line.split("\x[1F]");
        my $x = try EVAL $a;
        my $ea = $! ?? 1 !! 0;
        my $y = try EVAL $b;
        my $eb = $! ?? 1 !! 0;
        say $ea ?? 'unparseable-reference'
                !! $eb ?? 'unparseable-other'
                !! ((try { $x eqv $y }) ?? 'rendering' !! 'value');
        $*OUT.flush;
    }
    END

sub classify-pairs(@pairs) {
    return {} unless @pairs;
    my $tmp   = tmpdir();
    my $probe = $tmp.add('eqv-probe.raku');
    $probe.spurt($EQV-PROBE);

    # Evaluating arbitrary `.raku` text can kill the process, so this resumes
    # past whatever died instead of losing every pair after it — the same
    # discipline the generators need, for the same reason.
    my %by;
    my @todo = @pairs;
    while @todo {
        my $list = $tmp.add('eqv-pairs.txt');
        $list.spurt(@todo.map({ $_[0] ~ "\x[1F]" ~ $_[1] }).join("\n") ~ "\n");

        my %g = run-guarded($ENGINE, [$probe.absolute, $list.absolute], 120);
        my @v = %g<out>.lines;

        for ^@v -> $i {
            last if $i >= @todo.elems;
            %by{@todo[$i][0] ~ "\x[1F]" ~ @todo[$i][1]} = @v[$i];
        }
        last if @v.elems >= @todo.elems;

        # the pair right after the last verdict is the one that killed the run
        my $bad = @todo[@v.elems];
        %by{$bad[0] ~ "\x[1F]" ~ $bad[1]} = 'fatal-to-evaluate';
        @todo = @todo[(@v.elems + 1) .. *].list;
    }
    return %by;
}

# Every record where the engines on record disagree, clustered by the shape of
# the disagreement so a cluster of 28 identical ones reads as one line.
sub cmd-diverge(@selector) {
    my %clusters;
    my $records = 0;

    for grid-files() -> $f {
        my %parsed = parse-grid($f);
        next if @selector && !@selector.first({ ~$^s && $f.absolute.contains($^s) });

        for %parsed<records>.list -> %r {
            my $auth = authoritative(%r);
            next unless $auth;
            my $ref-obs = oracle-observation($auth);

            for (%r<oracle> // []).list -> $line {
                next if $line eq $auth;
                my $eng = engine-of($line);
                next if $eng eq engine-of($auth);
                my $obs = oracle-observation($line);
                next if comparable($obs) eq comparable($ref-obs);

                $records++;
                my $key = "$eng\t{ short-obs($ref-obs) }\t{ short-obs($obs) }";
                %clusters{$key} = [] unless %clusters{$key}:exists;
                %clusters{$key}.push: { id => id-of(%parsed, %r), code => (%r<code> // '').lines.join(' '),
                                        ref => $ref-obs, other => $obs };
            }
        }
    }

    unless %clusters {
        say "# no divergences on record";
        return;
    }

    my %class;
    if $CLASSIFY {
        my %uniq;
        for %clusters.values -> $cases {
            for $cases.list -> %c {
                next if %c<ref>.starts-with('ERR') || %c<other>.starts-with('ERR');
                next if %c<other>.contains('CRASH') || %c<other>.contains('HANG');
                next if %c<ref>.contains('NOCOMPILE') || %c<other>.contains('NOCOMPILE');
                %uniq{%c<ref> ~ "\x[1F]" ~ %c<other>} = [%c<ref>, %c<other>];
            }
        }
        say "# classifying { %uniq.elems } distinct renderings …";
        %class = classify-pairs(%uniq.values.list);
    }

    my %tally;
    for %clusters.keys.sort({ -%clusters{$_}.elems }) -> $key {
        my ($eng, $ref-obs, $obs) = $key.split("\t");
        my @cases = %clusters{$key}.list;
        my $tag = '';
        if $CLASSIFY {
            my $k = @cases[0]<ref> ~ "\x[1F]" ~ @cases[0]<other>;
            my $c = %class{$k} // 'not-a-value';
            %tally{$c} += @cases.elems;
            $tag = "  [$c]";
        }
        say "";
        say "{ @cases.elems } × $eng    reference: $ref-obs    got: $obs$tag";
        for @cases.head($VERB ?? @cases.elems !! 4) -> %c {
            say sprintf("    %-34s %s", %c<code>, %c<id>);
        }
        say "    … { @cases.elems - 4 } more (--verbose for all)" if !$VERB && @cases > 4;
    }
    say "";
    say "# $records divergent observation{ $records == 1 ?? '' !! 's' } in { %clusters.elems } cluster{ %clusters.elems == 1 ?? '' !! 's' }";
    if $CLASSIFY {
        for %tally.keys.sort({ -%tally{$_} }) -> $c {
            say "#   { sprintf('%-22s', $c) } { %tally{$c} }";
        }
    }
}

# A ladder cross is a matrix. Render it as one — far faster to scan than a list.
sub cmd-matrix($atom) {
    for grid-files() -> $f {
        my %parsed = parse-grid($f);
        my $name   = atom-of(%parsed);
        next unless $name eq $atom || $name.contains($atom);

        my $axes = %parsed<header><axes>;
        unless $axes {
            note "$name has no `axes` header — not a cross";
            next;
        }
        my @axes = $axes.split(' | ');

        my %cell;
        my %flagged;
        my %legend;
        for %parsed<records>.list -> %r {
            next unless %r<cell>;
            my ($a, $b) = %r<cell>.split(' | ');
            my $auth = authoritative(%r);
            my $ref-obs = $auth ?? oracle-observation($auth) !! '';
            %cell{"$a|$b"} = short-obs($ref-obs);
            %legend{short-obs($ref-obs)} = $ref-obs.substr(4) if $ref-obs.starts-with('ERR:');

            for (%r<oracle> // []).list -> $line {
                next if $line eq $auth;
                next if engine-of($line) eq engine-of($auth // '');
                if comparable(oracle-observation($line)) ne comparable($ref-obs) {
                    %flagged{"$a|$b"} = { id => id-of(%parsed, %r), code => %r<code>, ref => $ref-obs,
                                          other => $line };
                }
            }
        }

        my $w = 1;
        for %cell.values -> $v {
            $w = $v.chars if $v.chars > $w;
        }
        $w += 2;                               # the divergence marker, and a gap
        my $lw = @axes.map(*.chars).max;

        say "";
        say "$name    reference: { %parsed<records>[0] ?? engine-of(authoritative(%parsed<records>[0]) // '') !! '?' }";
        say "";
        my @cols = %parsed<header><cols> ?? %parsed<header><cols>.split(' | ') !! @axes;

        say (' ' x $lw) ~ ' │ ' ~ @cols.map({ sprintf("%-{$w}s", $_) }).join('').trim-trailing;
        say ('─' x $lw) ~ '─┼─' ~ ('─' x ($w * @cols.elems - 1));

        for @axes -> $a {
            my $row = sprintf("%-{$lw}s", $a) ~ ' │ ';
            for @cols -> $b {
                my $v = %cell{"$a|$b"} // '·';
                $v = '*' ~ $v if %flagged{"$a|$b"};
                $row ~= sprintf("%-{$w}s", $v);
            }
            say $row.trim-trailing;
        }

        if %legend {
            say "";
            for %legend.keys.sort -> $k {
                say "  $k = { %legend{$k} }";
            }
        }

        if %flagged {
            say "";
            say "* { %flagged.elems } cell{ %flagged.elems == 1 ?? '' !! 's' } where another engine disagrees:";
            for %flagged.keys.sort -> $k {
                my %d = %flagged{$k};
                say sprintf("    %-16s reference %-28s %s", %d<code>, %d<ref>, %d<other>);
            }
        }
        say "";
    }
}

sub cmd-adjudications() {
    my $n = 0;
    for grid-files() -> $f {
        my %parsed = parse-grid($f);
        for %parsed<records>.list -> %r {
            next unless %r<verdict>;
            $n++;
            say id-of(%parsed, %r) ~ '  [' ~ %r<verdict> ~ ']';
            say '    ' ~ %r<code>.lines.join(' ');
            say '    asserts: ' ~ (assertion-of(%r).map({ $_ ~ ' ' ~ %r{$_} }).join(', '));
            say '    ' ~ (%r<oracle> // []).join("\n    ");
            say '    why: ' ~ (%r<why> // '');
            say '    ruled: ' ~ (%r<ruled> // '');
            say '';
        }
    }
    say "# $n ruling{ $n == 1 ?? '' !! 's' }";
}

# ------------------------------------------------------------------- dispatch

my @args;
for @*ARGS -> $a {
    if $a.starts-with('--engine=') {
        $ENGINE = $a.substr(9);
    }
    elsif $a eq '--keep' {
        $KEEP = True;
    }
    elsif $a eq '--verbose' {
        $VERB = True;
    }
    elsif $a eq '--classify' {
        $CLASSIFY = True;
    }
    else {
        @args.push: $a;
    }
}

my $cmd = @args.shift // 'fire';

given $cmd {
    when 'fire'          { cmd-fire(@args) }
    when 'check'         { cmd-check() }
    when 'cover'         { cmd-cover() }
    when 'isolate'       { cmd-isolate(@args[0] // '') }
    when 'stats'         { cmd-stats() }
    when 'diverge'       { cmd-diverge(@args) }
    when 'matrix'        { cmd-matrix(@args[0] // '') }
    when 'adjudications' { cmd-adjudications() }
    default {
        note "usage: rakugrid [fire|check|cover|diverge|matrix <atom>|isolate <id>|adjudications]";
        note "                [--engine=<cmd>] [--verbose] [--keep]";
        exit 2;
    }
}
